if SHIELD_CORNE_DONGLE

# Max 16 caracteres
config ZMK_KEYBOARD_NAME
    default "Corne"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Duas metades (esquerda + direita) conectam no dongle
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Perifericos (2) + perfis BT (5)
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
